```env
# ==============================================================================
# 律所协同AI办公平台 - 环境变量配置模板 (.env.example)
# 说明：本文件为开发环境公开模板，严禁在此处填写任何真实的生产环境私钥。
# 实际本地开发请复制本文件为 .env.local 并完善相关配置。
# ==============================================================================

# 1. Supabase 基础核心配置 (前端与服务端通用，必须前缀 NEXT_PUBLIC_)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url_placeholder
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anonymous_public_key_placeholder

# 2. Supabase 服务端特权配置 (严禁暴露给前端客户端，用于绕过 RLS 执行系统级审计日志记录)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_secret_key_placeholder

# 3. AI 核心能力底座配置 (用于法律文书深度解析与自动化 SOP 组装引擎)
GEMINI_API_KEY=your_google_gemini_api_key_placeholder

# 4. 系统运行环境控制
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000