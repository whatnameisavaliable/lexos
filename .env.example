# Lexos 环境变量示例
#
# Vercel Preview 内存 demo 模式只需要保留：
# NEXT_PUBLIC_DEMO_MODE=true
#
# 真实 Supabase 模式需要把 NEXT_PUBLIC_DEMO_MODE 改为 false，
# 并补齐下面的 Supabase URL、anon key 和 service role key。
# 正式私有化部署前请执行 npm run private:check 和 npm run launch:check。
# 版本升级或补丁发布前请执行 npm run upgrade:check。
# 运维交接前请执行 npm run ops:log:check。
# 错误日志交接前请执行 npm run error:log:check。
# 性能监控交接前请执行 npm run perf:check。
# 多律所上线前请执行 npm run tenant:check。
NEXT_PUBLIC_DEMO_MODE=true

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

LEXOS_DEFAULT_ORGANIZATION_ID=00000000-0000-0000-0000-000000000001
LEXOS_AUTH_EMAIL_DOMAIN=lexos.local

# 默认管理员初始化脚本可选覆盖项。
LEXOS_ADMIN_USERNAME=admin
LEXOS_ADMIN_DISPLAY_NAME=系统管理员

# 真实闭环 smoke 脚本使用。
LEXOS_SMOKE_BASE_URL=http://127.0.0.1:3000
LEXOS_SMOKE_ADMIN_PASSWORD=
LEXOS_SMOKE_TEST_PASSWORD=

# Vercel Preview 远端冒烟测试使用。
LEXOS_PREVIEW_BASE_URL=
LEXOS_PREVIEW_EXPECT_MODE=demo

# Vercel Preview smoke and deployment evidence.
# Fill these after the approved Preview upload and smoke run. Do not store secrets here.
LEXOS_PREVIEW_SMOKE_REPORT_PATH=reports/preview-smoke/results.json
LEXOS_PREVIEW_DEPLOYMENT_REF=
LEXOS_PREVIEW_DEPLOYMENT_ID=
LEXOS_PREVIEW_BUILD_LOG_REF=
LEXOS_PREVIEW_SMOKE_REF=reports/preview-smoke/results.json
LEXOS_PREVIEW_DEPLOYMENT_OWNER=
LEXOS_PREVIEW_DEPLOYED_AT=
LEXOS_PREVIEW_CLAIM_URL=

# Vercel 部署通道核对使用。
# 只有在用户明确批准上传当前私有项目后，才将 LEXOS_DEPLOY_APPROVED_TO_UPLOAD 设置为 true。
LEXOS_DEPLOY_PROVIDER=vercel
LEXOS_DEPLOY_TARGET=preview
LEXOS_DEPLOY_METHOD=vercel-mcp
LEXOS_DEPLOY_APPROVED_TO_UPLOAD=false
LEXOS_DEPLOY_APPROVAL_REF=
LEXOS_DEPLOY_PRODUCTION_APPROVED=false
LEXOS_DEPLOY_EXPECTED_URL=

# RLS 直接表访问验证脚本使用。
LEXOS_RLS_TEST_USERNAME=lawyer01
LEXOS_RLS_TEST_PASSWORD=

# 私有化数据库备份与恢复脚本使用。
# 连接串必须是 percent-encoded 的 Postgres 直连连接串，不要提交到 Git。
LEXOS_DATABASE_URL=
LEXOS_BACKUP_DIR=backups
LEXOS_BACKUP_SCHEMAS=public,auth,storage
LEXOS_BACKUP_DRY_RUN=true
LEXOS_RESTORE_BACKUP_DIR=
LEXOS_RESTORE_EXECUTE=false
LEXOS_RESTORE_CONFIRM=
LEXOS_RESTORE_APPLY_ROLES=false

# 私有化 Storage 交付附件对象备份与恢复脚本使用。
# 默认 bucket 为 lexos-deliverables；恢复执行必须显式确认。
LEXOS_STORAGE_BUCKET=lexos-deliverables
LEXOS_STORAGE_BACKUP_DIR=backups
LEXOS_STORAGE_BACKUP_DRY_RUN=true
LEXOS_STORAGE_RESTORE_BACKUP_DIR=
LEXOS_STORAGE_RESTORE_EXECUTE=false
LEXOS_STORAGE_RESTORE_CONFIRM=
LEXOS_STORAGE_RESTORE_UPSERT=false

# 私有化备份调度计划与恢复演练报告使用。
# 第一版只生成计划和报告，不自动安装系统定时任务。
LEXOS_BACKUP_SCHEDULE_TIME=02:30
LEXOS_BACKUP_TIMEZONE=Asia/Shanghai
LEXOS_BACKUP_RETENTION_DAYS=30
LEXOS_BACKUP_REHEARSAL_INTERVAL_DAYS=30
LEXOS_BACKUP_REPORT_DIR=backups/reports

# 私有化备份系统任务安装核对使用。
# 第一版只输出安装核对清单，不调用 schtasks、crontab 或 systemctl。
LEXOS_BACKUP_TASK_OWNER=
LEXOS_BACKUP_TASK_RUN_AS=
LEXOS_BACKUP_TASK_PLATFORM=both
LEXOS_BACKUP_TASK_LOG_DIR=ops-logs/backups

# 私有化备份任务运行证据核对使用。
# 第一版只核对证据引用，不读取日志原文、不执行真实备份。
LEXOS_BACKUP_RUN_OWNER=
LEXOS_BACKUP_RUN_LAST_SUCCESS_AT=
LEXOS_BACKUP_RUN_MAX_AGE_HOURS=48
LEXOS_BACKUP_RUN_TASK_EXPORT_REF=
LEXOS_BACKUP_RUN_LOG_REF=
LEXOS_BACKUP_RUN_REHEARSAL_REF=

# 私有化备份离线加密核对使用。
# 第一版只输出加密策略和命令示例，不保存密钥、不执行真实加密。
LEXOS_BACKUP_ENCRYPTION_METHOD=manual
LEXOS_BACKUP_ENCRYPTION_KEY_REF=
LEXOS_BACKUP_ENCRYPTED_DIR=backups/encrypted
LEXOS_BACKUP_ENCRYPTED_COPY_COUNT=2
LEXOS_BACKUP_OFFSITE_COPY_REQUIRED=true

# 私有化备份失败告警核对使用。
# 第一版只输出告警制度清单，不发送邮件、不发短信、不调用 webhook。
LEXOS_BACKUP_ALERT_OWNER=
LEXOS_BACKUP_ALERT_CHANNELS=operations-log
LEXOS_BACKUP_ALERT_MAX_SILENCE_HOURS=24
LEXOS_BACKUP_ALERT_ESCALATION_HOURS=4

# 私有化备份异地/跨云镜像核对使用。
# 第一版只输出镜像交接清单，不上传文件、不调用对象存储 SDK、不记录访问密钥。
LEXOS_BACKUP_MIRROR_OWNER=
LEXOS_BACKUP_MIRROR_TARGET=manual-offsite
LEXOS_BACKUP_MIRROR_DESTINATION_REF=
LEXOS_BACKUP_MIRROR_MIN_COPIES=2
LEXOS_BACKUP_MIRROR_RPO_HOURS=24
LEXOS_BACKUP_MIRROR_VERIFY_INTERVAL_DAYS=30

# 私有化版本升级迁移核对使用。
# LEXOS_UPGRADE_APPLIED_MIGRATIONS 可填写已应用迁移文件名，逗号/分号/空白分隔均可。
LEXOS_UPGRADE_FROM_VERSION=
LEXOS_UPGRADE_TARGET_VERSION=
LEXOS_UPGRADE_APPLIED_MIGRATIONS=

# 最终部署验收报告使用。
# 只填写负责人、环境、版本和证据归档编号，不填写密钥、连接串或恢复口令。
LEXOS_FINAL_ACCEPTANCE_OWNER=
LEXOS_FINAL_ACCEPTANCE_ENVIRONMENT=
LEXOS_FINAL_ACCEPTANCE_RELEASE_VERSION=
LEXOS_FINAL_ACCEPTANCE_EVIDENCE_REF=
LEXOS_FINAL_ACCEPTANCE_ARCHIVE_DIR=reports/final-acceptance

# 最终交付证据索引与客户签收核对使用。
# 只填写负责人和签收编号/归档引用，不填写密钥、token、连接串或短信服务配置。
LEXOS_HANDOVER_OWNER=
LEXOS_HANDOVER_CLIENT_SIGNOFF_REF=
LEXOS_HANDOVER_RELEASE_APPROVER=
LEXOS_HANDOVER_OPERATIONS_OWNER=
LEXOS_HANDOVER_SECURITY_REVIEWER=

# 部署后回归核对清单使用。
# 只填写负责人、目标环境、版本、应用地址和回滚引用，不填写密钥、token、连接串或短信服务配置。
LEXOS_POST_DEPLOYMENT_OWNER=
LEXOS_POST_DEPLOYMENT_ENVIRONMENT=
LEXOS_POST_DEPLOYMENT_RELEASE_VERSION=
LEXOS_POST_DEPLOYMENT_BASE_URL=
LEXOS_POST_DEPLOYMENT_ROLLBACK_REF=
LEXOS_POST_DEPLOYMENT_OBSERVATION_OWNER=

# 私有化交付包清单核对使用。
# 第一版只核对本地交付清单，不生成压缩包、不读取密钥值、不连接线上 Supabase。
LEXOS_RELEASE_PACKAGE_VERSION=
LEXOS_RELEASE_PACKAGE_TARGET_ENV=
LEXOS_RELEASE_PACKAGE_MAINTAINER=

# 私有化运维日志核对使用。
# 第一版只生成制度和证据清单，不自动创建目录或写入日志。
LEXOS_OPERATIONS_LOG_DIR=ops-logs
LEXOS_OPERATIONS_LOG_OWNER=
LEXOS_OPERATIONS_LOG_RETENTION_DAYS=365
LEXOS_OPERATIONS_LOG_REVIEW_INTERVAL_DAYS=30

# 私有化错误日志核对使用。
# 第一版只生成分级和脱敏清单，不自动采集运行时日志。
LEXOS_ERROR_LOG_DESTINATION=server-runtime-log
LEXOS_ERROR_LOG_RETENTION_DAYS=180
LEXOS_ERROR_LOG_ALERT_CRITICAL=true

# 私有化性能监控核对使用。
# 第一版只生成指标和证据清单，不采集真实用户数据。
LEXOS_PERFORMANCE_OWNER=
LEXOS_PERFORMANCE_REVIEW_INTERVAL_DAYS=30
LEXOS_PERFORMANCE_SAMPLE_RETENTION_DAYS=180
