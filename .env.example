# =============================================================================
# LexOS — 环境变量模板（无真实秘密值）
# 使用方式：复制为 .env.development 并填写远端 Supabase 等真实参数
# 严禁将 .env.development / .env.production 提交至 Git
# =============================================================================

# --- 应用 ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
LOG_LEVEL=info
REQUEST_ID_HEADER=x-request-id
# 列表分页默认条数（≤50，与 architecture.md §2.3 一致）
PAGINATION_DEFAULT_LIMIT=50

# --- Supabase（开发期连接远端 Supabase 项目）---
# Dashboard → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Dashboard → Project Settings → API → service_role（仅服务端 U2/U3，禁止暴露给浏览器业务逻辑）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 自建 Auth 或 JWT 校验时需要；Supabase 云项目可从 Settings → API → JWT Secret 获取
SUPABASE_JWT_SECRET=your-jwt-secret

# Database → Connection string → Transaction pooler（推荐端口 6543，URI 模式）
# 示例：postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
SUPABASE_DB_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:6543/postgres

# --- Storage ---
STORAGE_BUCKET_MEDIA=media
STORAGE_BUCKET_EXPORTS=exports
STORAGE_SIGNED_URL_TTL_SEC=300
NEXT_PUBLIC_STORAGE_BUCKET_MEDIA=media
NEXT_PUBLIC_TASK_POLL_INTERVAL_MS=2000

# --- 认证与安全 ---
AUTH_VIRTUAL_EMAIL_DOMAIN=llexos.internal
# 内置 admin 种子与管理员重置初始口令（开发库可设；生产须强口令；禁止提交真实值）
# 开发示例（勿提交；须与 PRD §2.4.3 示例一致以便联调）：AUTH_INITIAL_PASSWORD=111111
AUTH_INITIAL_PASSWORD=
CAPTCHA_PROVIDER=none
CAPTCHA_SECRET_KEY=
# 可选，逗号分隔 CIDR；CAPTCHA_PROVIDER=none 时建议配置内网访问
LOGIN_IP_ALLOWLIST=
# 首期未启用 MFA；留空即可
MFA_REQUIRED_ROLES=

# --- U3 Pipeline Worker / Outbox（v1.3 · 无 Redis）---
# Worker 建议 Session pooler（5432）；留空则回退 SUPABASE_DB_URL（勿用模板占位符）
# WORKER_DB_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres
WORKER_DB_URL=
WORKER_POLL_INTERVAL_MS=1000
WORKER_MAX_CONCURRENCY=5
OUTBOX_MAX_ATTEMPTS=20
# 兼容旧名；留空则使用 WORKER_POLL_INTERVAL_MS
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_DB_URL=

# 【已废弃 v1.3】Redis / BullMQ 不再使用
# REDIS_URL=redis://127.0.0.1:6379

# --- Worker / FFmpeg ---
FFMPEG_PATH=ffmpeg
FFMPEG_MAX_CONCURRENT=2
FFMPEG_TIMEOUT_MS=3600000
WORKER_TMP_DIR=/tmp/lexos

# --- 队列路由与限流 ---
ASR_RATE_LIMIT_MAX=50
ASR_API_CONCURRENCY=3
STALLED_TASK_MAX_RETRIES=3
STALLED_TASK_IDLE_HOURS=2

# --- ASR / LLM（默认；生产凭证以 ai_model_credentials 表为准）---
ASR_PROVIDER_TYPE=openai
ASR_MAX_CHUNK_SIZE_MB=20
ASR_SEGMENT_DURATION_SEC=900
ASR_REQUEST_TIMEOUT_MS=120000
AI_DEFAULT_TIMEOUT_MS=60000
AI_TEST_TIMEOUT_MS=10000
# AES-256 密钥：32 字节随机值经 base64 编码（示例生成：node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"）
# 禁止提交真实值；缺失时 API 无法加解密 ai_model_credentials.api_key_ciphertext
AI_CREDENTIALS_ENCRYPTION_KEY=

# --- 可选 ---
REALTIME_ENABLED=false
# DB_POOL_MAX=10
# NODE_EXTRA_CA_CERTS=

# --- 前端（U1；见上方 Storage 段的 NEXT_PUBLIC_STORAGE_BUCKET_MEDIA）---
# NEXT_PUBLIC_API_URL=http://localhost:4000
