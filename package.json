{
  "name": "lexos",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "workers/*",
    "packages/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:supabase": "vitest run packages/shared/src/config/supabase-connectivity.test.ts",
    "verify:supabase-cli": "vitest run packages/shared/src/config/supabase-cli.test.ts",
    "seed:admin": "npx tsx packages/shared/src/seed/run-builtin-admin-cli.ts",
    "seed:sql": "npx tsx packages/shared/src/db/run-sql-file-cli.ts supabase/seed.sql",
    "db:push": "npx tsx packages/shared/src/db/apply-migrations-cli.ts",
    "db:fix-audit": "npx tsx packages/shared/src/db/run-sql-file-cli.ts supabase/migrations/20260530120000_fix_append_audit_log_digest.sql",
    "db:ensure-pgcrypto": "npx tsx packages/shared/src/db/run-sql-file-cli.ts supabase/scripts/ensure-pgcrypto.sql",
    "build:shared": "npm run build -w @lexos/shared",
    "dev": "npm run build:shared && npx --yes concurrently -k -n api,web -c blue,green \"npm run dev -w @lexos/api\" \"npm run dev -w @lexos/web\"",
    "dev:api": "npm run build:shared && npm run dev -w @lexos/api",
    "dev:api:kill": "npx --yes kill-port 4000",
    "dev:api:restart": "npm run dev:api:kill && npm run dev:api",
    "dev:web": "npm run build:shared && npm run dev -w @lexos/web",
    "worker:pipeline": "npm run build:shared && npm run start -w @lexos/worker-pipeline",
    "test:integration": "vitest run packages/shared/src/**/*.integration.test.ts",
    "verify:m0-gate": "npx tsx packages/shared/src/milestones/run-m0-gate-cli.ts"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "engines": {
    "node": ">=20"
  }
}
